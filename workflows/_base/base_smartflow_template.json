{
  "name": "Smartflow · worker and CRM publication",
  "nodes": [
    {
      "id": "e9337e1d-ea89-4eac-93a0-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "smartflow-v1",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "33c41853-ad53-46ae-9e05-8fe60bef4764"
    },
    {
      "id": "e9337e1d-ea89-4eac-93a0-000000000002",
      "name": "Python Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://host.docker.internal:8021/v1/workers/' + (['S1','S2','S3'].includes($json.body.stage) ? $json.body.stage : 'invalid') + '/run' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "e9337e1d-ea89-4eac-93a0-000000000003",
      "name": "Worker Completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "9790d78b-fa5d-49f4-953c-880462845bd5",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e9337e1d-ea89-4eac-93a0-000000000004",
      "name": "Need Human",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "9790d78b-fa5d-49f4-953c-880462845bd5",
              "leftValue": "={{ $json.body.need_human }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e9337e1d-ea89-4eac-93a0-000000000005",
      "name": "Wait 600ms",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 0.6,
        "unit": "seconds"
      },
      "webhookId": "b2ce3838-1b24-4267-874d-debd139235dc"
    },
    {
      "id": "e9337e1d-ea89-4eac-93a0-000000000006",
      "name": "Bitrix24 REST Dispatcher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8021/v1/publications/dispatch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { tenant_id: $json.body.tenant_id, request_id: $json.body.request_id, stage: $json.body.stage, purpose: 'stage_result' } }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "e9337e1d-ea89-4eac-93a0-000000000007",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Python Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Python Worker": {
      "main": [
        [
          {
            "node": "Worker Completed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Worker Completed": {
      "main": [
        [
          {
            "node": "Need Human",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Need Human": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 600ms",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 600ms": {
      "main": [
        [
          {
            "node": "Bitrix24 REST Dispatcher",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bitrix24 REST Dispatcher": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveExecutionProgress": false
  }
}
