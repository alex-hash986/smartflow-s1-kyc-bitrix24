        "jsonBody": "={{ (() => { const {tenant_id,request_id,profile_slug,profile_revision,package_id,s2_item_id} = $('Register package').first().json.body;\nconst context = {tenant_id,request_id,profile_slug,profile_revision}; const input = $('Normalize acceptance').first().json;\nconst gate = $('Verify tender award').first().json.body;\nreturn {...context, schema_version:'1',stage:'S3',attempt:input.attempt,received_at:input.received_at,\n  upstream_item:{entity_type_id:1044,item_id:s2_item_id},payload:{package_id,award:gate.award,documents:$json.body.payload.documents} }; })() }}",
