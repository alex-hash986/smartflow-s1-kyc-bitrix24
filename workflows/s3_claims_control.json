      "position": [
        3840,
        360
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst status = result.statusCode;\nif (status === 200 && typeof result.body?.status === 'string') {\n  const {status: publication_status, item_id, comment_id} = result.body;\n  const statusCode = publication_status === 'published' ? 200 : (publication_status === 'reconcile' ? 409 : 202);\n  const source = $('Build final publication').isExecuted ? $('Build final publication') : $('Build review publication');\n  const {request_id, package_id, attempt} = source.first().json.body;\n  return [{json:{statusCode,body:{publication_status,item_id,comment_id,request_id,package_id,attempt}}}];\n}\nconst messages = {202:'Processing in progress; retry the same delivery',401:'Kernel authentication failed',\n  409:'S3 state or portal decision could not be confirmed',422:'Invalid S3 payload',503:'Kernel or portal temporarily unavailable'};\nreturn [{json:{statusCode:Object.hasOwn(messages,status) ? status : 502,body:{detail:messages[status] ?? 'S3 workflow request failed'}}}];"
      }
