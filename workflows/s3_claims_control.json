      "name": "Normalize acceptance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst uuid = v => typeof v === 'string' && /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v);\nconst positive = v => Number.isSafeInteger(v) && v > 0;\nconst fail = [{json:{statusCode:422,body:{detail:'Invalid S3 event'}}}];\nif (!uuid(b.request_id)) return fail;\nconst context = {tenant_id:'portal_b24_b2b', profile_slug:'portal_b24_b2b', profile_revision:'5', request_id:b.request_id};\nconst attempt = b.attempt ?? 1;\nif (!positive(attempt) || !positive(b.s2_item_id) || typeof b.delivery_key !== 'string'\n    || !b.delivery_key.trim() || !Array.isArray(b.documents) || !b.documents.length\n    || typeof b.received_at !== 'string' || !Number.isFinite(Date.parse(b.received_at))) return fail;\nreturn [{json:{statusCode:200,attempt,received_at:b.received_at,body:{\n  ...context, s2_item_id:b.s2_item_id, delivery_key:b.delivery_key.trim(), documents:b.documents\n}}}];"
      }
    },
    {
      "id": "e21a58e8-4efb-5ec3-992b-e37c933fd738",
      "name": "Normalize decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        460
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst uuid = v => typeof v === 'string' && /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(v);\nconst positive = v => Number.isSafeInteger(v) && v > 0;\nconst fail = [{json:{statusCode:422,body:{detail:'Invalid S3 event'}}}];\nconst context = {tenant_id:'portal_b24_b2b', profile_slug:'portal_b24_b2b', profile_revision:'5'};\nif (uuid(b.request_id) && uuid(b.package_id) && positive(b.attempt)) {\n  return [{json:{statusCode:200,body:{...context,request_id:b.request_id,package_id:b.package_id,attempt:b.attempt}}}];\n}\nconst rawItem = b.item_id ?? (b.event === 'ONCRMDYNAMICITEMUPDATE'\n  ? (b.data?.FIELDS?.ID ?? b['data[FIELDS][ID]']) : null);\nconst item_id = typeof rawItem === 'string' && /^[1-9][0-9]*$/.test(rawItem) ? Number(rawItem) : rawItem;\nif (!positive(item_id)) return fail;\nreturn [{json:{statusCode:200,body:{...context,item_id}}}];"
      }
