      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst parsed = $('Parse requisites').first().json.body.payload;\nconst receipt = $('Register delivery').first().json.body;\nif (result.statusCode === 200 && result.body?.inn === parsed.inn && result.body?.ogrn === parsed.ogrn) {\n  return [{json:result.body}];\n}\nreturn [{json:{inn:parsed.inn,ogrn:parsed.ogrn,observed_at:receipt.received_at,\n  legal_entity_status:null,registration_age_months:null,charter_capital_rub:null,\n  tax_debt_rub:null,defendant_claims_rub:null,fns_address_unreliable:null,bankruptcy:null}}];"
      }
