      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst {delivery_key, source_type, text, pdf_base64, scenario = 'green'} = body;\nconst isText = source_type === 'TEXT' && typeof text === 'string' && pdf_base64 == null;\nconst isPdf = source_type === 'PDF' && typeof pdf_base64 === 'string' && text == null;\nif (typeof delivery_key !== 'string' || delivery_key.trim() === ''\n    || !(isText || isPdf) || !['green','arbitration','bankruptcy','timeout'].includes(scenario)) {\n  return [{json:{statusCode:422,body:{detail:'Invalid S1 test application'}}}];\n}\nconst payload = {source_type, text:isText ? text : null, pdf_base64:isPdf ? pdf_base64 : null};\nreturn [{json:{statusCode:200,body:{\n  tenant_id:'portal_b24_b2b',source:'s1-test-webhook',delivery_key:delivery_key.trim(),\n  profile_slug:'portal_b24_b2b',profile_revision:'4',channel:'n8n',\n  is_after_hours:false,run_origin:'mock',payload:{...payload,scenario}\n}}}];"
      }
    },
